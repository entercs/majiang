.round-input {
  padding-bottom: 200rpx;
  background: #F7F5F0;
  min-height: 100vh;
}
.group {
  background: #fff;
  margin: 24rpx;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}
.group-title {
  font-size: 26rpx;
  color: #999999;
  padding: 16rpx 24rpx;
  background: #F7F5F0;
}
.player-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  padding: 24rpx;
}
.player-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx;
  border: 2rpx solid #EEEEEE;
  border-radius: 24rpx;
}
.player-card.selected {
  border-color: #0F7A38;
  background: #E8F5ED;
}
.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
}
.nick {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #1A1A1A;
}
.radio-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  border-bottom: 2rpx solid #EEEEEE;
}
.radio-row:last-child {
  border-bottom: none;
}
.field-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  border-bottom: 2rpx solid #EEEEEE;
}
.field-row:last-child {
  border-bottom: none;
}
.field-label {
  font-size: 30rpx;
  color: #1A1A1A;
}
.field-input {
  flex: 1;
  text-align: right;
  font-size: 30rpx;
  padding: 8rpx 16rpx;
  color: #0F7A38;
}
.gang-row {
  display: flex;
  gap: 24rpx;
  align-items: center;
  padding: 16rpx 24rpx;
  border-bottom: 2rpx solid #EEEEEE;
}
.add-gang-row {
  padding: 16rpx 24rpx;
}
.btn-mini {
  padding: 8rpx 24rpx;
  background: #fff;
  color: #0F7A38;
  border: 2rpx solid #0F7A38;
  border-radius: 16rpx;
  font-size: 24rpx;
  line-height: 1.4;
}
.btn-mini::after {
  border: none;
}
.footer {
  padding: 40rpx 24rpx;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-top: 2rpx solid #EEEEEE;
}
.btn {
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  border-radius: 20rpx;
  margin: 0;
}
.btn.primary {
  background: linear-gradient(90deg, #0F7A38, #2BA85A);
  color: #fff;
  border: none;
  box-shadow: 0 4rpx 16rpx rgba(15, 122, 56, 0.2);
}
.btn.primary::after {
  border: none;
}