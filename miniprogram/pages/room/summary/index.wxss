.summary {
  padding: 24rpx 32rpx;
  background: #F7F5F0;
  min-height: 100vh;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.rank-list {
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}
.rank-row {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 2rpx solid #EEEEEE;
  min-height: 120rpx;
  box-sizing: border-box;
  gap: 20rpx;
}
.rank-row.first {
  background: #FFF8DC;
  border-left: 6rpx solid #C8A96E;
  padding-left: 18rpx;
}
.rank-row:last-child {
  border-bottom: none;
}
.rank-no {
  width: 40rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #0F7A38;
  flex-shrink: 0;
  font-variant-numeric: tabular-nums;
}
.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin-left: 8rpx;
  flex-shrink: 0;
}
.nick {
  flex: 1;
  margin-left: 16rpx;
  font-size: 30rpx;
  color: #1A1A1A;
  font-weight: 500;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  line-height: 1.5;
}
.score {
  font-size: 40rpx;
  font-weight: 600;
  color: #1A1A1A;
  flex: 0 0 212rpx;
  display: flex;
  align-items: baseline;
  justify-content: flex-end;
  gap: 8rpx;
  white-space: nowrap;
  line-height: 1.3;
}
.btn {
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  border-radius: 20rpx;
  margin: 40rpx 0 0;
}
.btn.primary {
  background: linear-gradient(90deg, #0F7A38, #2BA85A);
  color: #fff;
  border: none;
  box-shadow: 0 4rpx 16rpx rgba(15, 122, 56, 0.2);
}
.btn.primary::after {
  border: none;
}
.summary-title {
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.4;
  color: #1A1A1A;
  margin: 8rpx 0 24rpx;
}
.rank-person {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}
.score-number {
  text-align: right;
  font-variant-numeric: tabular-nums;
}
.score-unit {
  font-size: 26rpx;
  font-weight: 400;
  color: #707870;
  flex-shrink: 0;
}
