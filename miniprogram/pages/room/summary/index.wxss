.summary {
  padding: 24rpx;
  background: #F7F5F0;
  min-height: 100vh;
}
.rank-list {
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}
.rank-row {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 2rpx solid #EEEEEE;
}
.rank-row.first {
  background: #FFF8DC;
  border-left: 6rpx solid #C8A96E;
  padding-left: 18rpx;
}
.rank-row:last-child {
  border-bottom: none;
}
.rank-no {
  width: 60rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #0F7A38;
}
.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin-left: 16rpx;
}
.nick {
  flex: 1;
  margin-left: 16rpx;
  font-size: 28rpx;
  color: #1A1A1A;
}
.score {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A1A1A;
}
.btn {
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  border-radius: 20rpx;
  margin: 40rpx 0 0;
}
.btn.primary {
  background: linear-gradient(90deg, #0F7A38, #2BA85A);
  color: #fff;
  border: none;
  box-shadow: 0 4rpx 16rpx rgba(15, 122, 56, 0.2);
}
.btn.primary::after {
  border: none;
}