<view class="room">
  <view class="code-bar">
    <text class="code-label">房间号</text>
    <text class="code-value" bind:tap="onCopyCode">{{roomCode}}</text>
    <text class="share-btn" bind:tap="onOpenSharePopup">邀请</text>
    <text class="leave-btn" bind:tap="onLeaveRoom">退出</text>
  </view>

  <!-- 4 家横排（按 seatIndex 排序，人数不限） -->
  <view class="players-row {{playersRow.length <= 4 ? 'players-row-fit' : ''}}">
    <block wx:for="{{playersRow}}" wx:key="_id">
      <view class="player-card {{item._id === currentPlayerId ? 'self' : ''}} {{!item.isOnline ? 'offline' : ''}}" bind:tap="onTapPlayer" data-id="{{item._id}}" data-self="{{item._id === currentPlayerId}}">
        <image class="avatar {{!item.isOnline ? 'offline' : ''}}" src="/images/avatars/avatar-{{item.avatarIndex || 0}}.png" mode="aspectFit"></image>
        <text class="nick">{{item.nickname}}</text>
        <text class="score">{{item.totalScore}}</text>
      </view>
    </block>
  </view>

  <!-- 排行榜（可滚动，超出视口高度时滚动） -->
  <view class="rank-section">
    <view class="rank-header">
      <view class="rank-title">排行榜</view>
      <view class="base-score-badge" bindtap="onTapBaseScore">
        <text class="base-score-label">底分</text>
        <text class="base-score-value">{{baseScore}}</text>
      </view>
    </view>

    <!-- 底分修改弹窗 -->
    <base-score-popup
      wx:if="{{baseScorePopupVisible}}"
      initial-value="{{baseScore}}"
      auto-focus="{{false}}"
      bind:confirm="onBaseScoreConfirm"
      bind:cancel="onBaseScoreCancel"
    ></base-score-popup>
    <scroll-view class="rank-scroll" scroll-y>
      <view class="rank-list">
        <block wx:for="{{rankList}}" wx:key="_id">
          <view class="rank-row {{index === 0 ? 'first' : ''}}" bind:tap="onTapPlayer" data-id="{{item._id}}" data-self="{{item._id === currentPlayerId}}">
            <view class="rank-person">
              <text class="rank-no">{{index + 1}}</text>
              <image class="rank-avatar" src="/images/avatars/avatar-{{item.avatarIndex || 0}}.png" mode="aspectFit"></image>
              <text class="rank-nick">{{item.nickname}}</text>
            </view>
            <view class="rank-metrics">
              <view class="rank-score"><text class="rank-score-number">{{item.totalScore}}</text><text class="score-unit">分</text></view>
              <view class="rank-delta-slot">
                <text class="rank-delta {{item.lastDelta > 0 ? 'pos' : 'neg'}}" wx:if="{{item.lastDelta !== 0}}">{{item.lastDelta > 0 ? '+' : ''}}{{item.lastDelta}}</text>
              </view>
            </view>
          </view>
        </block>
        <view wx:if="{{rankList.length === 0}}" class="empty-rank">还没有人记分，点上方头像开始</view>
      </view>
    </scroll-view>
  </view>

  <!-- 底部操作（所有人通用） -->
  <view class="actions actions-2">
    <view class="action-btn auto" bind:tap="onAutoScore">辅助算分</view>
    <view class="action-btn history" bind:tap="onShowHistory">历史记录</view>
  </view>

  <view class="sync-bar" wx:if="{{scorePending}}" bindtap="onReconcileScore">有一笔给分待确认，点此核对</view>

  <!-- 同步状态条 -->
  <view class="sync-bar" wx:if="{{syncStatus !== 'connected'}}">
    <text>{{syncText}}</text>
  </view>

  <!-- 加分弹窗组件 -->
  <score-popup
    wx:if="{{popupVisible}}"
    target-nick="{{popupTarget.nickname}}"
    bind:confirm="onPopupConfirm"
    bind:cancel="onPopupCancel"
  ></score-popup>

  <!-- self 操作弹窗（头像选择 / 修改昵称） -->
  <player-popup
    wx:if="{{selfPopupVisible}}"
    player-id="{{selfPopupTarget._id}}"
    nickname="{{selfPopupTarget.nickname}}"
    avatar-index="{{selfPopupTarget.avatarIndex}}"
    total-score="{{selfPopupTarget.totalScore}}"
    bind:close="onSelfPopupClose"
    bind:confirm="onSelfPopupConfirm"
    bind:editnick="onSelfEditNick"
  ></player-popup>

  <!-- 邀请二维码弹窗 -->
  <view class="share-popup-mask" wx:if="{{sharePopupVisible}}" catch:tap="onCloseSharePopup">
    <view class="share-popup" catch:tap="noop">
      <view class="share-popup-title">邀请好友加入</view>
      <view class="share-popup-qrcode">
        <image wx:if="{{shareQrCodeSrc}}"
               class="qrcode-img {{shareQrCodeReady ? '' : 'qrcode-pending'}}"
               src="{{shareQrCodeSrc}}"
               mode="aspectFit"
               bindload="onQrCodeLoaded"
               binderror="onQrCodeImageError"></image>
        <view wx:if="{{shareQrCodeLoading}}" class="qrcode-status qrcode-overlay">二维码加载中...</view>
        <view wx:if="{{!shareQrCodeLoading && !shareQrCodeReady}}" class="qrcode-failed qrcode-overlay">
          <view class="qrcode-status">二维码暂时不可用</view>
          <view class="qrcode-retry-btn" bind:tap="onRetryQRCode">重试</view>
        </view>
      </view>
      <view class="share-popup-room-code">房间号 {{roomCode}}</view>
      <view class="share-popup-hint">朋友扫一扫即可加入</view>
      <view class="share-popup-close-btn" bind:tap="onCloseSharePopup">关闭</view>
    </view>
  </view>
</view>
