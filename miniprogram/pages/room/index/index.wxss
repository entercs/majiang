.room {
  padding: 24rpx 32rpx;
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
  min-height: 100vh;
  box-sizing: border-box;
  background: #F7F5F0;
  display: flex;
  flex-direction: column;
}

/* 顶部信息栏 */
.code-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
  margin-bottom: 24rpx;
}
.code-label {
  font-size: 26rpx;
  color: #666666;
  flex-shrink: 0;
}
.code-value {
  font-size: 38rpx;
  font-weight: 600;
  color: #0F7A38;
  flex: 1;
  letter-spacing: 2rpx;
  min-width: 0;
  font-variant-numeric: tabular-nums;
}
.share-btn {
  font-size: 26rpx;
  color: #0F7A38;
  padding: 8rpx 16rpx;
  border: 2rpx solid #0F7A38;
  border-radius: 16rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  flex-shrink: 0;
}
.share-btn:active {
  background: #E8F5ED;
}
.leave-btn {
  font-size: 26rpx;
  color: #D32F2F;
  padding: 8rpx 16rpx;
  border: 2rpx solid #D32F2F;
  border-radius: 16rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  flex-shrink: 0;
}
.leave-btn:active {
  background: #D32F2F;
  color: #fff;
}

/* 玩家横排卡片 */
.players-row {
  display: flex;
  gap: 12rpx;
  margin-top: 0;
  padding: 16rpx 12rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
  overflow-x: auto;
  box-sizing: border-box;
}
.player-card {
  flex: 0 0 144rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 0;
  border: 2rpx solid transparent;
  border-radius: 24rpx;
  box-sizing: border-box;
  min-width: 0;
}
.player-card.self {
  border-color: #0F7A38;
  background: #E8F5ED;
}
.player-card:active {
  background: #f5f5f5;
}
.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
}
.avatar.offline {
  opacity: 0.5;
  filter: grayscale(1);
}
.player-card.offline {
  opacity: 1;
}
.nick {
  font-size: 28rpx;
  color: #1A1A1A;
  margin-top: 8rpx;
  max-width: calc(100% - 12rpx);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-weight: 500;
  line-height: 1.4;
}
.score {
  font-size: 32rpx;
  font-weight: 600;
  margin-top: 4rpx;
  color: #1A1A1A;
  line-height: 1.3;
  font-variant-numeric: tabular-nums;
}

/* 排行榜模块 */
.rank-section {
  margin-top: 24rpx;
  background: #fff;
  border-radius: 32rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 0;
}
.rank-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  border-bottom: 2rpx solid #EEEEEE;
  flex-shrink: 0;
}
.rank-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
}
.base-score-badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 20rpx;
  background: #F7F5F0;
  border-radius: 16rpx;
}
.base-score-label {
  font-size: 26rpx;
  color: #666666;
}
.base-score-value {
  font-size: 30rpx;
  font-weight: 600;
  color: #0F7A38;
}
.base-score-badge:active {
  background: #EEEEEE;
}
.rank-scroll {
  flex: 1;
  min-height: 0;
}
.rank-list {}
.rank-row {
  display: flex;
  align-items: center;
  min-height: 120rpx;
  padding: 16rpx 24rpx;
  border-bottom: 2rpx solid #EEEEEE;
  overflow: hidden;
  box-sizing: border-box;
  gap: 16rpx;
}
.rank-row:last-child {
  border-bottom: none;
}
/* 第一名淡金色背景 + 金色左边框 */
.rank-row.first {
  background: #FFF8DC;
  border-left: 6rpx solid #C8A96E;
  padding-left: 18rpx;
}
.rank-no {
  font-size: 30rpx;
  font-weight: 600;
  color: #0F7A38;
  flex-shrink: 0;
  width: 40rpx;
  font-variant-numeric: tabular-nums;
}
.rank-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  margin-right: 12rpx;
  flex-shrink: 0;
}
.rank-nick {
  font-size: 30rpx;
  color: #1A1A1A;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
  min-width: 0;
  max-width: none;
  font-weight: 500;
  line-height: 1.5;
}
.rank-delta {
  font-size: 26rpx;
  font-weight: 600;
  color: #0F7A38;
  margin-left: 0;
  flex-shrink: 0;
  line-height: 30rpx;
  font-variant-numeric: tabular-nums;
}
.rank-delta.pos {
  color: #0F7A38;
}
.rank-delta.neg {
  color: #D32F2F;
}
.rank-score {
  font-size: 40rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-left: 0;
  flex-shrink: 0;
  width: 100%;
  display: flex;
  justify-content: flex-end;
  align-items: baseline;
  gap: 8rpx;
  white-space: nowrap;
  line-height: 1.2;
}
.empty-rank {
  text-align: center;
  color: #999999;
  padding: 40rpx;
  font-size: 26rpx;
}

/* 底部操作栏 */
.actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 16rpx;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 2rpx solid #EEEEEE;
  box-sizing: border-box;
}
.action-btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  font-size: 32rpx;
  font-weight: 500;
}
.action-btn.auto {
  background: linear-gradient(90deg, #0F7A38, #2BA85A);
  color: #fff;
  box-shadow: 0 4rpx 16rpx rgba(15, 122, 56, 0.2);
}
.action-btn.history {
  background: #fff;
  color: #0F7A38;
  border: 2rpx solid #0F7A38;
}
.action-btn.finish {
  background: #fff;
  color: #D32F2F;
  border: 2rpx solid #D32F2F;
}
.action-btn:active {
  opacity: 0.8;
}

.sync-bar {
  padding: 12rpx;
  background: #FFF8DC;
  color: #856404;
  text-align: center;
  font-size: 26rpx;
}

/* === 分享二维码弹窗 === */
.share-popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}
.share-popup {
  width: 560rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.share-popup-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #0F7A38;
  margin-bottom: 32rpx;
}
.share-popup-qrcode {
  width: 400rpx;
  height: 400rpx;
  background: #F5F5F5;
  border-radius: 12rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}
.qrcode-img {
  width: 400rpx;
  height: 400rpx;
}
.qrcode-status {
  font-size: 26rpx;
  color: #999;
  text-align: center;
}
.qrcode-failed {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.qrcode-retry-btn {
  margin-top: 20rpx;
  padding: 12rpx 36rpx;
  background: #0F7A38;
  color: #fff;
  border-radius: 12rpx;
  font-size: 26rpx;
}
.share-popup-room-code {
  font-size: 30rpx;
  color: #333;
  font-weight: 700;
  letter-spacing: 4rpx;
  margin-top: 32rpx;
}
.share-popup-hint {
  font-size: 26rpx;
  color: #666666;
  margin-top: 8rpx;
  margin-bottom: 32rpx;
  line-height: 1.5;
}
.share-popup-close-btn {
  width: 100%;
  height: 80rpx;
  border-radius: 16rpx;
  background: #F5F5F5;
  color: #666;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}
/* 四人及以下均分宽度；更多玩家维持横向浏览。 */
.players-row-fit .player-card {
  flex: 1 1 0;
}
.rank-person {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}
.rank-metrics {
  flex: 0 0 212rpx;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}
.rank-score-number {
  font-variant-numeric: tabular-nums;
  text-align: right;
}
.score-unit {
  font-size: 26rpx;
  font-weight: 400;
  color: #707870;
  flex-shrink: 0;
}
.rank-delta-slot {
  height: 30rpx;
  line-height: 30rpx;
  margin-top: 4rpx;
  text-align: right;
}
