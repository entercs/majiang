.history { padding: 24rpx; min-height: 100vh; background: #f5f5f5; }
.empty { text-align: center; color: #999; padding: 80rpx 0; font-size: 28rpx; }

.session { background: #fff; border-radius: 12rpx; margin-bottom: 24rpx; overflow: hidden; }
.session.ongoing { border: 2rpx solid #1aad19; }
.session-header { display: flex; align-items: center; gap: 16rpx; padding: 24rpx; border-bottom: 1rpx solid #f0f0f0; }
.session-title { font-size: 32rpx; font-weight: 700; color: #333; }
.session-tag-ongoing { font-size: 22rpx; color: #fff; background: #1aad19; padding: 4rpx 12rpx; border-radius: 6rpx; }
.session-time { font-size: 24rpx; color: #7A7E83; margin-left: auto; }

.session-list { padding: 8rpx 24rpx 16rpx; }
.transfer-row { display: flex; align-items: center; padding: 14rpx 0; border-bottom: 1rpx dashed #f0f0f0; }
.transfer-row:last-child { border-bottom: none; }
.transfer-from { font-size: 28rpx; color: #333; max-width: 200rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.transfer-arrow { font-size: 28rpx; color: #7A7E83; margin: 0 12rpx; }
.transfer-to { font-size: 28rpx; color: #333; flex: 1; max-width: 200rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.transfer-value { font-size: 28rpx; font-weight: 600; }
.transfer-value.pos { color: #07c160; }
.empty-session { text-align: center; color: #999; padding: 20rpx; font-size: 24rpx; }
