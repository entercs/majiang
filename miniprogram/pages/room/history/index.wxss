.history {
  padding: 24rpx 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  min-height: 100vh;
  background: #F7F5F0;
  box-sizing: border-box;
}
.empty {
  text-align: center;
  color: #707870;
  padding: 80rpx 0;
  font-size: 28rpx;
  line-height: 1.5;
}

.session {
  background: #fff;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}
.session-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #DCECE1;
  background: linear-gradient(90deg, #E8F5ED, #F6FAF7);
}
.session-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #0F7A38;
  line-height: 1.4;
  letter-spacing: 1rpx;
  font-variant-numeric: tabular-nums;
}
.session-list {
  padding: 8rpx 24rpx 16rpx;
}
.transfer-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx dashed #EEEEEE;
  min-height: 84rpx;
  box-sizing: border-box;
  gap: 16rpx;
}
.transfer-row:last-child {
  border-bottom: none;
}
.transfer-from {
  font-size: 30rpx;
  color: #1A1A1A;
  max-width: none;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
  min-width: 0;
  line-height: 1.5;
}
.transfer-arrow {
  font-size: 28rpx;
  color: #999999;
  margin: 0 12rpx;
  flex: 0 0 28rpx;
  text-align: center;
}
.transfer-to {
  font-size: 30rpx;
  color: #1A1A1A;
  flex: 1;
  max-width: none;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  min-width: 0;
  line-height: 1.5;
}
.transfer-value {
  font-size: 34rpx;
  font-weight: 600;
  flex: 0 0 164rpx;
  text-align: right;
  white-space: nowrap;
  min-width: 0;
  font-variant-numeric: tabular-nums;
  line-height: 1.3;
}
.transfer-value.pos {
  color: #0F7A38;
}
.transfer-value.neg {
  color: #D32F2F;
}
.empty-session {
  text-align: center;
  color: #707870;
  padding: 20rpx;
  font-size: 26rpx;
}
.session-stamp {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 8rpx 14rpx;
  border: 1rpx solid #CCE5D5;
  border-radius: 12rpx;
  background: #EFF8F2;
}
.timestamp-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #0F7A38;
  box-shadow: 0 0 0 5rpx #D8EDDF;
  flex-shrink: 0;
}
.transfer-parties {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}
