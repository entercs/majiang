.history {
  padding: 24rpx;
  padding-bottom: env(safe-area-inset-bottom);
  min-height: 100vh;
  background: #F7F5F0;
}
.empty {
  text-align: center;
  color: #999999;
  padding: 80rpx 0;
  font-size: 28rpx;
}

.session {
  background: #fff;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}
.session-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx;
  border-bottom: 2rpx solid #EEEEEE;
}
.session-title {
  font-size: 34rpx;
  font-weight: 500;
  color: #1A1A1A;
}
.session-list {
  padding: 8rpx 24rpx 16rpx;
}
.transfer-row {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx dashed #EEEEEE;
}
.transfer-row:last-child {
  border-bottom: none;
}
.transfer-from {
  font-size: 28rpx;
  color: #1A1A1A;
  max-width: 200rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.transfer-arrow {
  font-size: 28rpx;
  color: #999999;
  margin: 0 12rpx;
}
.transfer-to {
  font-size: 28rpx;
  color: #1A1A1A;
  flex: 1;
  max-width: 200rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.transfer-value {
  font-size: 28rpx;
  font-weight: 600;
}
.transfer-value.pos {
  color: #0F7A38;
}
.transfer-value.neg {
  color: #D32F2F;
}
.empty-session {
  text-align: center;
  color: #999999;
  padding: 20rpx;
  font-size: 24rpx;
}