<view class="history">
  <view wx:if="{{historyError && !loading}}" class="empty" bindtap="_loadHistory">历史加载失败，点击重试</view>
  <view wx:if="{{loading}}" class="empty">正在加载历史记录...</view>
  <view wx:if="{{!loading && groups.length === 0}}" class="empty">
    <text>还没有历史记录</text>
  </view>

  <block wx:for="{{groups}}" wx:for-item="group" wx:for-index="gi" wx:key="startTime">
    <view class="session">
      <view class="session-header">
        <view class="session-stamp">
          <view class="timestamp-dot"></view>
          <text class="session-title">{{group.timeText}}</text>
        </view>
      </view>
      <view class="session-list">
        <block wx:for="{{group.transfers}}" wx:for-item="t" wx:key="id">
          <view class="transfer-row">
            <view class="transfer-parties">
              <text class="transfer-from">{{t.from}}</text>
              <text class="transfer-arrow">→</text>
              <text class="transfer-to">{{t.to}}</text>
            </view>
            <text class="transfer-value {{t.value > 0 ? 'pos' : ''}}">+{{t.value}}</text>
          </view>
        </block>
        <view wx:if="{{group.transfers.length === 0}}" class="empty-session">（无操作）</view>
      </view>
    </view>
  </block>
</view>
