<view class="auto-score">
  <!-- 顶栏：玩法切换 + 底分 -->
  <view class="topbar">
    <view class="topbar-item">
      <text class="topbar-label">玩法</text>
      <picker mode="selector" range="{{ruleTypes}}" value="{{ruleTypeIndex}}"
              bindchange="onRuleTypeChange">
        <view class="picker-value">
          <text>{{ruleTypes[ruleTypeIndex]}}</text>
          <text class="arrow">▾</text>
        </view>
      </picker>
    </view>
    <view class="topbar-item">
      <text class="topbar-label">底分</text>
      <view class="base-score-stepper">
        <view class="stepper-btn {{baseScoreEditable <= baseScoreMin ? 'disabled' : ''}}" bindtap="onBaseScoreChange" data-value="{{baseScoreEditable - 1}}">−</view>
        <text class="stepper-num">{{baseScoreEditable}}</text>
        <view class="stepper-btn {{baseScoreEditable >= baseScoreMax ? 'disabled' : ''}}" bindtap="onBaseScoreChange" data-value="{{baseScoreEditable + 1}}">+</view>
      </view>
    </view>
  </view>

  <!-- 付给 -->
  <view class="section">
    <view class="section-title">付给</view>
    <view wx:if="{{otherPlayers.length === 0}}" class="empty-hint">房间里没有其他玩家</view>
    <view class="players-grid" wx:else>
      <view wx:for="{{otherPlayers}}" wx:key="_id"
            class="player-card {{targetId === item._id ? 'selected' : ''}}"
            bindtap="onTargetChange" data-id="{{item._id}}">
        <image class="avatar" src="/images/avatars/avatar-{{item.avatarIndex || 0}}.png" mode="aspectFit"></image>
        <text class="nick">{{item.nickname}}</text>
      </view>
    </view>
  </view>

  <!-- 总番数大展示 -->
  <view class="total-card {{canHu ? 'can-hu' : 'cannot-hu'}}">
    <view class="total-row">
      <text class="total-num">{{ruleType === 'sichuan' ? cappedFan : totalFan}}</text>
      <text class="total-unit">{{ruleType === 'sichuan' ? '番' : '炮'}}{{ruleType === 'sichuan' && totalFan > cappedFan ? '（封顶）' : ''}}</text>
    </view>
    <view wx:if="{{ruleType !== 'sichuan'}}" class="can-hu-text">{{totalFan < 2 ? '❌ 不可胡牌（炮数不足2炮）' : '✅ 可胡牌'}}</view>
    <view wx:if="{{ruleType === 'sichuan' && canHu}}" class="final-multiplier">
      倍数：{{multiplier}}倍{{cappedFan < totalFan ? '（4番封顶）' : ''}}
    </view>
  </view>

  <!-- ==================== 黄梅麻将 ==================== -->
  <block wx:if="{{ruleType === 'huangmei'}}">
    <!-- 牌型 -->
    <view class="section">
      <view class="section-title">牌型</view>
      <view class="chip-grid">
        <view wx:for="{{hmCardTypes}}" wx:key="key"
              class="chip {{hmCardTypeSelected[item.key] ? 'selected' : ''}}"
              bindtap="onCardTypeChange" data-value="{{item.key}}">
          <text>{{item.label}}</text>
        </view>
      </view>
    </view>

    <!-- 胡牌方式 -->
    <view class="section">
      <view class="section-title">胡牌方式</view>
      <view class="chip-grid">
        <view wx:for="{{hmWinTypes}}" wx:key="key"
              class="chip {{winType === item.key ? 'selected' : ''}}"
              bindtap="onWinTypeChange" data-value="{{item.key}}">
          <text>{{item.label}}</text>
        </view>
      </view>
    </view>

    <!-- 门清与听牌型 -->
    <view class="section">
      <view class="section-title">门清与听牌型</view>
      <view class="chip-grid">
        <view wx:for="{{qmOptions}}" wx:key="key"
              class="chip {{qmType === item.key ? 'selected' : ''}} {{qmDisabledMap[item.key] ? 'disabled' : ''}}"
              bindtap="onQmChange" data-value="{{item.key}}">
          <text>{{item.label}}</text>
        </view>
      </view>
      <view wx:if="{{qmHint}}" class="disabled-hint">（{{qmHint}}）</view>
    </view>

    <!-- 字牌与杠牌 -->
    <view class="section">
      <view class="section-title">字牌与杠牌</view>

      <view class="sub-section">
        <view class="sub-title">发财</view>
        <view class="chip-grid">
          <view wx:for="{{facaiOptions}}" wx:key="key"
                class="chip {{facai === item.key ? 'selected' : ''}}"
                bindtap="onFacaiChange" data-value="{{item.key}}">
            <text>{{item.label}}</text>
          </view>
        </view>
      </view>

      <view class="sub-section">
        <view class="sub-title">明杠数牌</view>
        <view class="chip-grid">
          <view wx:for="{{mingGangOptions}}" wx:key="key"
                class="chip {{mingGang === item.key ? 'selected' : ''}} {{gangDisabled && mingGang === null ? 'disabled' : ''}}"
                bindtap="onMingGangChange" data-value="{{item.key}}">
            <text>{{item.label}}</text>
          </view>
        </view>
      </view>

      <view class="sub-section">
        <view class="sub-title">暗杠数牌</view>
        <view class="chip-grid">
          <view wx:for="{{anGangOptions}}" wx:key="key"
                class="chip {{anGang === item.key ? 'selected' : ''}} {{gangDisabled && anGang === null ? 'disabled' : ''}}"
                bindtap="onAnGangChange" data-value="{{item.key}}">
            <text>{{item.label}}</text>
          </view>
        </view>
      </view>

      <view class="sub-section">
        <view class="sub-title">红中</view>
        <view class="chip-grid">
          <view wx:for="{{hongZhongOptions}}" wx:key="key"
                class="chip {{hongZhong === item.key ? 'selected' : ''}} {{gangDisabled && hongZhong !== item.key ? 'disabled' : ''}}"
                bindtap="onHongZhongChange" data-value="{{item.key}}">
            <text>{{item.label}}</text>
          </view>
        </view>
      </view>

      <view class="sub-section">
        <view class="sub-title">白板</view>
        <view class="chip-grid">
          <view wx:for="{{baiBanOptions}}" wx:key="key"
                class="chip {{baiBan === item.key ? 'selected' : ''}} {{gangDisabled && baiBan !== item.key ? 'disabled' : ''}}"
                bindtap="onBaiBanChange" data-value="{{item.key}}">
            <text>{{item.label}}</text>
          </view>
        </view>
      </view>
    </view>
  </block>

  <!-- ==================== 四川麻将 ==================== -->
  <block wx:if="{{ruleType === 'sichuan'}}">
    <!-- 基础牌型（单选） -->
    <view class="section">
      <view class="section-title">基础牌型</view>
      <view class="chip-grid">
        <view wx:for="{{scCardTypes}}" wx:key="key"
              class="chip {{scCardTypeSelected[item.key] ? 'selected' : ''}}"
              bindtap="onScCardTypeChange" data-value="{{item.key}}">
          <text>{{item.label}}</text>
        </view>
      </view>
    </view>

    <!-- 特殊加番项（多选） -->
    <view class="section">
      <view class="section-title">特殊加番</view>
      <view class="chip-grid">
        <view wx:for="{{scSpecialWinTypes}}" wx:key="key"
              class="chip {{specialWinTypeSelected[item.key] ? 'selected' : ''}} {{specialWinTypeDisabled ? 'disabled' : ''}}"
              bindtap="onSpecialWinTypeChange" data-value="{{item.key}}">
          <text>{{item.label}}</text>
        </view>
      </view>
      <view class="special-hint">以上加番项可叠加，每项+1番{{specialWinTypeDisabled ? '（天胡/地胡无需特殊加番）' : ''}}</view>
    </view>

    <!-- 根的数量 -->
    <view class="section">
      <view class="section-title">根的数量</view>
      <view class="gen-control">
        <view class="gen-label">每有一组四张相同的牌 +1 番（最多3根）</view>
        <view class="stepper">
          <view class="stepper-btn {{genCountLocked || genCount <= 0 ? 'disabled' : ''}}" bindtap="onGenCountChange" data-value="{{genCount - 1}}">−</view>
          <text class="stepper-num">{{genCount}}</text>
          <view class="stepper-btn {{genCountLocked || genCount >= genCountMax ? 'disabled' : ''}}" bindtap="onGenCountChange" data-value="{{genCount + 1}}">+</view>
        </view>
        <view wx:if="{{genCountLocked}}" class="gen-locked-hint">（龙七对自带1根，锁定）</view>
      </view>
    </view>

    </block>

  <view class="footer">
    <view class="btn default" bindtap="onReset">重置</view>
    <view class="btn primary {{canApply ? '' : 'disabled'}}" bindtap="onApply">应用</view>
  </view>

  <!-- 确认弹窗 -->
  <view class="confirm-overlay" wx:if="{{showConfirmDialog}}">
    <view class="confirm-dialog">
      <view class="confirm-title">确认付分</view>

      <!-- 明细 -->
      <view class="confirm-breakdown">
        <view class="breakdown-header">
          <text class="bd-col-name">番型</text>
          <text class="bd-col-fan">{{ruleType === 'sichuan' ? '番' : '炮'}}</text>
          <text class="bd-col-score">分数</text>
        </view>
        <view class="breakdown-row" wx:for="{{fanBreakdown}}" wx:key="name">
          <text class="bd-name">{{item.name}}</text>
          <text class="bd-fan">+{{item.fan}}</text>
          <text class="bd-score">+{{item.score || 0}}</text>
        </view>
        <view class="breakdown-total">
          <text>合计</text>
          <text class="bd-fan-total">{{totalFan}} {{ruleType === 'sichuan' ? '番' : '炮'}}</text>
          <text class="bd-score-total">{{amount}} 分</text>
        </view>
        <view wx:if="{{ruleType === 'sichuan' && cappedDeduction > 0}}" class="capped-deduction">封顶扣减：-{{cappedDeduction}} 番</view>
        <view wx:if="{{ruleType === 'sichuan' && cappedFan < totalFan}}" class="capped-note">（已按4番封顶计算）</view>
      </view>

      <!-- 付分预览 -->
      <view class="confirm-preview">
        <view class="preview-text">你付给 <text class="preview-name">{{targetName}}</text></view>
        <view class="preview-amount">{{amount}} <text class="preview-unit">分</text></view>
        <view class="preview-meta" wx:if="{{ruleType === 'sichuan'}}">
          （{{baseScoreEditable}} 底分 × 2^{{cappedFan}} = {{multiplier}} 倍）
        </view>
        <view class="preview-meta" wx:else>
          （{{totalFan}} {{ruleType === 'sichuan' ? '番' : '炮'}} × {{baseScoreEditable}} 底分）
        </view>
      </view>

      <view class="confirm-btns">
        <view class="btn default" bindtap="onCancel">取消</view>
        <view class="btn primary" bindtap="onConfirm">确认</view>
      </view>
    </view>
  </view>
</view>