<view class="auto-score">
  <view class="section">
    <view class="section-title">1. 我要付给谁</view>
    <view class="players-row">
      <block wx:for="{{otherPlayers}}" wx:key="_id">
        <view class="player-card {{targetId === item._id ? 'selected' : ''}}" bind:tap="onSelectTarget" data-id="{{item._id}}">
          <image class="avatar" src="/images/avatars/avatar-{{item.avatarIndex || 0}}.png" mode="aspectFit"></image>
          <text class="nick">{{item.nickname}}</text>
        </view>
      </block>
    </view>
  </view>

  <view class="section">
    <view class="section-title">2. 怎么胡的</view>
    <view class="types">
      <view class="type-item {{winType === 'zimo' ? 'selected' : ''}}" bind:tap="onSelectWinType" data-type="zimo">
        <text>自摸</text>
      </view>
      <view class="type-item {{winType === 'dianpao' ? 'selected' : ''}}" bind:tap="onSelectWinType" data-type="dianpao">
        <text>点炮</text>
      </view>
    </view>
  </view>

  <view class="preview-card" wx:if="{{targetId && winType}}">
    <view class="preview-text">你付给 <text class="preview-name">{{targetName}}</text></view>
    <view class="preview-amount">{{amount}} <text class="preview-unit">分</text></view>
    <view class="preview-meta">（{{winTypeLabel}} · 1 番）</view>
  </view>

  <view class="footer">
    <view class="btn primary {{canApply ? '' : 'disabled'}}" bind:tap="onApply">应用</view>
  </view>
</view>
