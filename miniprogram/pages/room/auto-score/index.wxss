.auto-score {
  padding: 24rpx 32rpx;
  padding-bottom: 220rpx;
  min-height: 100vh;
  background: #F7F5F0;
  box-sizing: border-box;
}
.auto-score {
  /* 玩法配置弹窗样式已迁移到独立页面 pages/room/rule-config */
}

/* 顶栏 */
.topbar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.topbar-item {
  flex: 1;
  background: #fff;
  border-radius: 24rpx;
  padding: 16rpx 20rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  overflow: hidden;
  box-sizing: border-box;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}
.topbar-label {
  font-size: 28rpx;
  color: #999999;
}
.picker-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 36rpx;
  font-weight: 600;
  color: #1A1A1A;
}
.picker-value .arrow {
  color: #999999;
  font-size: 24rpx;
}
.topbar-input {
  font-size: 36rpx;
  font-weight: 600;
  color: #1A1A1A;
}
.topbar-value {
  font-size: 36rpx;
  font-weight: 600;
  color: #0F7A38;
}
.base-score-stepper {
  display: flex;
  align-items: center;
  background: #F7F5F0;
  border-radius: 16rpx;
  overflow: hidden;
}
.base-score-stepper .stepper-btn:first-child {
  border-top-left-radius: 16rpx;
  border-bottom-left-radius: 16rpx;
}
.base-score-stepper .stepper-btn:last-child {
  border-top-right-radius: 16rpx;
  border-bottom-right-radius: 16rpx;
}
.base-score-stepper .stepper-btn {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #0F7A38;
  font-weight: 600;
}
.base-score-stepper .stepper-btn:active:not(.disabled) {
  background: #E8F5ED;
}
.base-score-stepper .stepper-num {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #1A1A1A;
  padding: 0 4rpx;
  min-width: 48rpx;
}

/* 总番数大卡 */
.total-card {
  border-radius: 24rpx;
  padding: 40rpx 24rpx;
  margin-bottom: 24rpx;
  text-align: center;
  color: #fff;
  transition: background 0.2s;
}
.total-card.can-hu {
  background: linear-gradient(135deg, #0F7A38, #2BA85A);
}
.total-card.cannot-hu {
  background: linear-gradient(135deg, #D32F2F, #B71C1C);
}
.total-row {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 8rpx;
}
.total-num {
  font-size: 96rpx;
  font-weight: 800;
  line-height: 1;
}
.total-unit {
  font-size: 36rpx;
  font-weight: 600;
}
.can-hu-text {
  font-size: 26rpx;
  margin-top: 8rpx;
  opacity: 0.95;
}
.final-multiplier {
  font-size: 28rpx;
  margin-top: 12rpx;
  opacity: 0.9;
  font-weight: 600;
}

/* section 通用 */
.section {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}
.section-disabled {
  opacity: 0.6;
}
.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 16rpx;
}
.disabled-hint {
  color: #707870;
  font-size: 26rpx;
  padding: 8rpx 0 0;
  line-height: 1.5;
}

/* 子区段：标题左对齐固定宽度，选项右区左对齐 */
.sub-section {
  display: flex;
  align-items: flex-start;
  padding: 12rpx 0;
  border-bottom: 1rpx dashed #EEEEEE;
}
.sub-section:last-child {
  border-bottom: none;
}
.sub-title {
  flex-shrink: 0;
  width: 140rpx;
  font-size: 26rpx;
  color: #666666;
  line-height: 56rpx;
}

/* chip 标签网格 */
.chip-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 14rpx 24rpx;
  border: 2rpx solid #EEEEEE;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #666666;
  background: #fff;
  transition: all 0.15s;
  box-sizing: border-box;
}
.chip.selected {
  border-color: #0F7A38;
  background: #E8F5ED;
  color: #0F7A38;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(15, 122, 56, 0.2);
}
.chip.disabled {
  opacity: 0.4;
  background: #f8f8f8;
  color: #999999;
}
.chip.disabled.selected {
  opacity: 0.4;
  background: #f8f8f8;
  color: #999999;
  border-color: #EEEEEE;
  box-shadow: none;
}
.chip:active:not(.disabled) {
  transform: scale(0.97);
}

/* 番数明细（3列：番型/番/分数） */
.breakdown .empty-hint {
  color: #999999;
  font-size: 26rpx;
  padding: 16rpx 0;
}
.breakdown-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
  border-bottom: 1rpx solid #EEEEEE;
  margin-bottom: 4rpx;
}
.bd-col-name {
  font-size: 26rpx;
  color: #707870;
  flex: 1;
  min-width: 0;
}
.bd-col-fan {
  font-size: 26rpx;
  color: #707870;
  width: 80rpx;
  text-align: center;
  flex: 0 0 80rpx;
}
.bd-col-score {
  font-size: 26rpx;
  color: #707870;
  width: 120rpx;
  text-align: right;
  flex: 0 0 120rpx;
}
.breakdown-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx dashed #EEEEEE;
}
.breakdown-row:last-of-type {
  border-bottom: none;
}
.bd-name {
  font-size: 28rpx;
  color: #1A1A1A;
  flex: 1;
  min-width: 0;
  padding-right: 12rpx;
  line-height: 1.5;
}
.bd-fan {
  font-size: 28rpx;
  color: #0F7A38;
  font-weight: 600;
  width: 80rpx;
  text-align: center;
  flex: 0 0 80rpx;
  font-variant-numeric: tabular-nums;
}
.bd-score {
  font-size: 28rpx;
  color: #1A1A1A;
  font-weight: 600;
  width: 120rpx;
  text-align: right;
  flex: 0 0 120rpx;
  font-variant-numeric: tabular-nums;
}
.breakdown-total {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0 4rpx;
  margin-top: 8rpx;
  border-top: 2rpx solid #0F7A38;
  font-size: 30rpx;
  font-weight: 600;
  color: #0F7A38;
}
.bd-fan-total {
  font-size: 32rpx;
  font-weight: 600;
  flex: 0 0 80rpx;
  text-align: center;
}
.bd-score-total {
  font-size: 32rpx;
  font-weight: 600;
  flex: 0 0 120rpx;
  text-align: right;
  font-variant-numeric: tabular-nums;
}
.bd-cap {
  color: #999999;
  font-size: 24rpx;
  font-weight: 400;
  margin-left: 8rpx;
}

/* 玩家网格 */
.players-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.player-card {
  width: calc((100% - 12rpx) / 2);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
  border: 2rpx solid #EEEEEE;
  border-radius: 24rpx;
  box-sizing: border-box;
  background: #fff;
}
.player-card.selected {
  border-color: #0F7A38;
  background: #E8F5ED;
}
.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
}
.nick {
  font-size: 28rpx;
  color: #1A1A1A;
  margin-top: 8rpx;
  max-width: 90%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-weight: 500;
  line-height: 1.4;
}

/* 预览 */
.preview-card {
  background: linear-gradient(135deg, #0F7A38, #2BA85A);
  border-radius: 24rpx;
  padding: 32rpx 24rpx;
  margin-bottom: 24rpx;
  text-align: center;
  color: #fff;
  box-shadow: 0 4rpx 16rpx rgba(15, 122, 56, 0.2);
}
.preview-text {
  font-size: 28rpx;
  opacity: 0.95;
  margin-bottom: 12rpx;
}
.preview-name {
  font-weight: 700;
}
.preview-amount {
  font-size: 80rpx;
  font-weight: 800;
  line-height: 1.2;
  letter-spacing: 4rpx;
}
.preview-unit {
  font-size: 32rpx;
  font-weight: 600;
  opacity: 0.9;
}
.preview-meta {
  font-size: 26rpx;
  opacity: 0.8;
  margin-top: 8rpx;
  line-height: 1.5;
}

/* 底部 */
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 16rpx;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 2rpx solid #EEEEEE;
}
.btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  font-size: 32rpx;
  font-weight: 500;
}
.btn.primary {
  background: linear-gradient(90deg, #0F7A38, #2BA85A);
  color: #fff;
  box-shadow: 0 4rpx 16rpx rgba(15, 122, 56, 0.2);
}
.btn.default {
  background: #F5F5F5;
  color: #666666;
}
.btn.disabled {
  opacity: 0.5;
}
.btn:active {
  opacity: 0.8;
}

/* 确认弹窗 */
.confirm-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}
.confirm-dialog {
  background: #fff;
  border-radius: 32rpx;
  padding: 40rpx 32rpx;
  width: 88%;
  max-width: 640rpx;
  box-sizing: border-box;
  box-shadow: 0 16rpx 64rpx rgba(0, 0, 0, 0.12);
}
.confirm-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1A1A1A;
  text-align: center;
  margin-bottom: 32rpx;
}
.confirm-breakdown {
  background: #F7F5F0;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 24rpx;
}
.confirm-breakdown .breakdown-header {
  padding-bottom: 8rpx;
  border-bottom: 1rpx solid #EEEEEE;
  margin-bottom: 4rpx;
}
.confirm-breakdown .breakdown-row {
  padding: 8rpx 0;
}
.confirm-breakdown .breakdown-total {
  border-top: 2rpx solid #0F7A38;
  margin-top: 8rpx;
  padding-top: 8rpx;
}
.confirm-preview {
  background: linear-gradient(135deg, #0F7A38, #2BA85A);
  border-radius: 24rpx;
  padding: 32rpx 24rpx;
  text-align: center;
  color: #fff;
  margin-bottom: 32rpx;
}
.confirm-preview .preview-text {
  font-size: 28rpx;
  opacity: 0.95;
  margin-bottom: 12rpx;
}
.confirm-preview .preview-name {
  font-weight: 700;
}
.confirm-preview .preview-amount {
  font-size: 72rpx;
  font-weight: 800;
  line-height: 1.2;
  letter-spacing: 2rpx;
}
.confirm-preview .preview-unit {
  font-size: 28rpx;
  font-weight: 600;
  opacity: 0.9;
}
.confirm-preview .preview-meta {
  font-size: 26rpx;
  opacity: 0.8;
  margin-top: 8rpx;
  line-height: 1.5;
}
.confirm-btns {
  display: flex;
  gap: 16rpx;
}
.confirm-btns .btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  font-size: 32rpx;
  font-weight: 500;
}

/* 四川麻将 - 根数量控制 */
.gen-control {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
}
.gen-label {
  font-size: 26rpx;
  color: #666666;
  flex: 1;
}
.stepper {
  display: flex;
  align-items: center;
  gap: 0;
  background: #F7F5F0;
  border-radius: 16rpx;
  overflow: hidden;
}
.stepper-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #0F7A38;
  font-weight: 600;
  background: #F7F5F0;
}
.stepper-btn:active:not(.disabled) {
  background: #E8F5ED;
}
.stepper-btn.disabled {
  color: #CCCCCC;
}
.stepper-num {
  min-width: 80rpx;
  text-align: center;
  font-size: 36rpx;
  font-weight: 700;
  color: #1A1A1A;
  padding: 0 16rpx;
}
.gen-locked-hint {
  font-size: 26rpx;
  color: #707870;
  width: 100%;
  line-height: 1.5;
}

/* 四川麻将提示 */
.sichuan-hint {
  font-size: 26rpx;
  color: #707870;
  padding: 8rpx 0 0;
  line-height: 1.5;
}
.special-hint {
  font-size: 26rpx;
  color: #707870;
  padding: 8rpx 0 0;
  line-height: 1.5;
}
.capped-deduction {
  font-size: 26rpx;
  color: #D32F2F;
  padding: 8rpx 0 0;
  text-align: right;
}
.capped-note {
  font-size: 24rpx;
  color: #D32F2F;
  padding: 4rpx 0 0;
}

/* 玩法配置提示语 */
.config-hint {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #E8F5ED;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 24rpx;
}
.config-hint-text {
  font-size: 26rpx;
  color: #0F7A38;
  flex: 1;
}
.btn-config {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 10rpx 20rpx;
  background: #0F7A38;
  border-radius: 16rpx;
  font-size: 26rpx;
  color: #fff;
  font-weight: 500;
}

/* 玩法配置弹窗样式已迁移到独立页面 pages/room/rule-config */
.breakdown-total > text:first-child {
  flex: 1;
  min-width: 0;
}
