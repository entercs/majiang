.auto-score { padding: 24rpx; padding-bottom: 220rpx; min-height: 100vh; background: #f5f5f5; box-sizing: border-box; }

/* 顶栏 */
.topbar { display: flex; gap: 16rpx; margin-bottom: 24rpx; }
.topbar-item { flex: 1; background: #fff; border-radius: 12rpx; padding: 16rpx 20rpx; display: flex; flex-direction: column; gap: 8rpx; }
.topbar-label { font-size: 24rpx; color: #7A7E83; }
.picker-value { display: flex; align-items: center; justify-content: space-between; font-size: 30rpx; font-weight: 600; color: #333; }
.picker-value .arrow { color: #7A7E83; font-size: 24rpx; }
.topbar-input { font-size: 30rpx; font-weight: 600; color: #333; }

/* 总番数大卡 */
.total-card { border-radius: 16rpx; padding: 40rpx 24rpx; margin-bottom: 24rpx; text-align: center; color: #fff; transition: background 0.2s; }
.total-card.can-hu { background: linear-gradient(135deg, #1aad19, #4cd964); }
.total-card.cannot-hu { background: #c0392b; }
.total-row { display: flex; align-items: baseline; justify-content: center; gap: 8rpx; }
.total-num { font-size: 96rpx; font-weight: 800; line-height: 1; }
.total-unit { font-size: 36rpx; font-weight: 600; }
.can-hu-text { font-size: 26rpx; margin-top: 8rpx; opacity: 0.95; }

/* section 通用 */
.section { background: #fff; border-radius: 12rpx; padding: 24rpx; margin-bottom: 16rpx; }
.section-disabled { opacity: 0.6; }
.section-title { font-size: 28rpx; font-weight: 600; color: #333; margin-bottom: 16rpx; }
.disabled-hint { color: #7A7E83; font-size: 24rpx; }

/* 子区段（红中/白板各一） */
.sub-section { margin-bottom: 12rpx; }
.sub-section:last-child { margin-bottom: 0; }
.sub-title { font-size: 26rpx; color: #7A7E83; margin-bottom: 12rpx; }

/* chip 标签网格 */
.chip-grid { display: flex; flex-wrap: wrap; gap: 12rpx; }
.chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 14rpx 24rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #333;
  background: #fff;
  transition: all 0.15s;
}
.chip.selected {
  border-color: #1aad19;
  background: #f0f8e8;
  color: #1aad19;
  font-weight: 600;
}
.chip:active { opacity: 0.7; }

/* 计数器 */
.counter-row { display: flex; align-items: center; padding: 12rpx 0; border-bottom: 1rpx solid #f0f0f0; gap: 16rpx; }
.counter-row:last-child { border-bottom: none; }
.counter-label { width: 140rpx; font-size: 28rpx; color: #333; }
.counter-buttons { display: flex; align-items: center; gap: 8rpx; }
.counter-btn { width: 40rpx; height: 40rpx; line-height: 40rpx; padding: 0; margin: 0; font-size: 26rpx; background: #f0f0f0; color: #333; border-radius: 8rpx; }
.counter-btn[disabled] { background: #f8f8f8; color: #ccc; }
.counter-value { width: 40rpx; text-align: center; font-size: 28rpx; font-weight: 600; color: #333; }
.counter-hint { font-size: 22rpx; color: #7A7E83; flex: 1; text-align: right; }

/* 番数明细 */
.breakdown .empty-hint { color: #7A7E83; font-size: 26rpx; padding: 16rpx 0; }
.breakdown-row { display: flex; justify-content: space-between; align-items: center; padding: 12rpx 0; border-bottom: 1rpx dashed #f0f0f0; }
.breakdown-row:last-of-type { border-bottom: none; }
.bd-name { font-size: 28rpx; color: #333; }
.bd-fan { font-size: 28rpx; color: #1aad19; font-weight: 600; }
.breakdown-total { display: flex; justify-content: space-between; align-items: center; padding: 16rpx 0 4rpx; margin-top: 8rpx; border-top: 2rpx solid #1aad19; font-size: 30rpx; font-weight: 600; color: #1aad19; }
.bd-fan-total { font-size: 36rpx; font-weight: 800; }

/* 玩家网格 */
.players-grid { display: flex; flex-wrap: wrap; gap: 12rpx; }
.player-card { width: calc((100% - 12rpx) / 2); display: flex; flex-direction: column; align-items: center; padding: 16rpx 0; border: 2rpx solid #e0e0e0; border-radius: 12rpx; box-sizing: border-box; }
.player-card.selected { border-color: #1aad19; background: #f0f8e8; }
.avatar { width: 64rpx; height: 64rpx; border-radius: 50%; }
.nick { font-size: 24rpx; color: #333; margin-top: 8rpx; max-width: 90%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

/* 预览 */
.preview-card { background: linear-gradient(135deg, #1aad19, #4cd964); border-radius: 16rpx; padding: 32rpx 24rpx; margin-bottom: 24rpx; text-align: center; color: #fff; box-shadow: 0 4rpx 16rpx rgba(26, 173, 25, 0.2); }
.preview-text { font-size: 28rpx; opacity: 0.95; margin-bottom: 12rpx; }
.preview-name { font-weight: 700; }
.preview-amount { font-size: 80rpx; font-weight: 800; line-height: 1.2; letter-spacing: 4rpx; }
.preview-unit { font-size: 32rpx; font-weight: 600; opacity: 0.9; }
.preview-meta { font-size: 22rpx; opacity: 0.8; margin-top: 8rpx; }

/* 底部 */
.footer { position: fixed; bottom: 0; left: 0; right: 0; display: flex; gap: 16rpx; padding: 24rpx; background: #fff; border-top: 1rpx solid #f0f0f0; }
.btn { flex: 1; height: 88rpx; line-height: 88rpx; text-align: center; border-radius: 12rpx; font-size: 32rpx; font-weight: 600; }
.btn.primary { background: #1aad19; color: #fff; }
.btn.default { background: #f5f5f5; color: #333; }
.btn.disabled { opacity: 0.5; }
.btn:active { opacity: 0.8; }
