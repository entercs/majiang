.auto-score { padding: 24rpx; padding-bottom: 200rpx; min-height: 100vh; background: #f5f5f5; box-sizing: border-box; }
.section { background: #fff; border-radius: 12rpx; padding: 24rpx; margin-bottom: 24rpx; }
.section-title { font-size: 28rpx; font-weight: 600; color: #333; margin-bottom: 16rpx; }
.players-row { display: flex; gap: 12rpx; }
.player-card { flex: 1; display: flex; flex-direction: column; align-items: center; padding: 16rpx 0; border: 2rpx solid #e0e0e0; border-radius: 12rpx; }
.player-card.selected { border-color: #1aad19; background: #f0f8e8; }
.avatar { width: 64rpx; height: 64rpx; border-radius: 50%; }
.nick { font-size: 22rpx; color: #333; margin-top: 8rpx; max-width: 90rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.types { display: flex; flex-wrap: wrap; gap: 12rpx; }
.type-item { padding: 16rpx 24rpx; border: 2rpx solid #e0e0e0; border-radius: 8rpx; font-size: 26rpx; }
.type-item.selected { border-color: #1aad19; background: #f0f8e8; color: #1aad19; }
.fan-input { width: 100%; padding: 16rpx; border: 2rpx solid #e0e0e0; border-radius: 8rpx; font-size: 30rpx; box-sizing: border-box; }
.preview { }
.preview-row { display: flex; justify-content: space-between; align-items: center; padding: 16rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.preview-row:last-child { border-bottom: none; }
.preview-rank { font-size: 28rpx; color: #333; }
.preview-score { font-size: 30rpx; font-weight: 600; }
.preview-score.positive { color: #d33; }
.preview-score.negative { color: #1aad19; }
.footer { position: fixed; bottom: 0; left: 0; right: 0; display: flex; gap: 16rpx; padding: 24rpx; background: #fff; border-top: 1rpx solid #f0f0f0; }
.btn { flex: 1; height: 80rpx; line-height: 80rpx; text-align: center; border-radius: 12rpx; font-size: 30rpx; }
.btn.primary { background: #1aad19; color: #fff; }
.btn.default { background: #fff; color: #333; border: 1rpx solid #e0e0e0; }
.btn.disabled { opacity: 0.5; }
.btn:active { opacity: 0.8; }
