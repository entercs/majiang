<view class="rule-config">
  <view class="section">
    <view class="section-title">牌型炮数</view>
    <view class="setting" wx:for="{{cardTypes}}" wx:key="key">
      <view class="setting-info">
        <text class="setting-label">{{item.label}}</text>
        <text class="setting-desc">{{item.desc}}</text>
      </view>
      <view class="stepper">
        <view class="stepper-btn {{item.readonly ? 'disabled' : ''}}"
              bindtap="onCardMinus" data-key="{{item.key}}">−</view>
        <text class="stepper-num">{{item.fan}}</text>
        <view class="stepper-btn {{item.readonly ? 'disabled' : ''}}"
              bindtap="onCardPlus" data-key="{{item.key}}">+</view>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">胡牌方式炮数</view>
    <view class="setting" wx:for="{{winTypes}}" wx:key="key">
      <view class="setting-info">
        <text class="setting-label">{{item.label}}</text>
        <text class="setting-desc">{{item.desc}}</text>
      </view>
      <view class="stepper">
        <view class="stepper-btn {{item.readonly ? 'disabled' : ''}}"
              bindtap="onWinMinus" data-key="{{item.key}}">−</view>
        <text class="stepper-num">{{item.fan}}</text>
        <view class="stepper-btn {{item.readonly ? 'disabled' : ''}}"
              bindtap="onWinPlus" data-key="{{item.key}}">+</view>
      </view>
    </view>
  </view>

  <view class="footer">
    <button class="btn reset-btn" wx:if="{{isOwner}}" bindtap="onReset">重置</button>
    <button class="btn cancel-btn" bindtap="onCancel">取消</button>
    <button class="btn primary-btn {{isOwner ? '' : 'disabled'}}" bindtap="onApply">
      {{isOwner ? '应用' : '仅房主可修改'}}
    </button>
  </view>
</view>