.home { padding: 40rpx 40rpx 60rpx; min-height: 100vh; box-sizing: border-box; }
.hero { text-align: center; margin: 40rpx 0 60rpx; }
.title { display: block; font-size: 72rpx; font-weight: 700; color: #1aad19; letter-spacing: 8rpx; }

.profile { display: flex; flex-direction: column; align-items: center; gap: 16rpx; padding: 32rpx; background: #fff; border-radius: 16rpx; margin-bottom: 40rpx; }
.profile:active { background: #f5f5f5; }
.avatar { width: 120rpx; height: 120rpx; border-radius: 50%; background: #f0f0f0; }
.nick { font-size: 32rpx; font-weight: 600; color: #333; }

.actions { display: flex; flex-direction: column; gap: 24rpx; }
.btn { width: 100%; height: 88rpx; line-height: 88rpx; font-size: 32rpx; border-radius: 12rpx; margin: 0; }
.btn.primary { background: #1aad19; color: #fff; border: none; }
.btn.primary::after { border: none; }
.btn.default { background: #fff; color: #333; border: 1rpx solid #e0e0e0; }
.btn.default::after { border: none; }

.recent { margin-top: 60rpx; }
.recent-title { font-size: 26rpx; color: #7A7E83; margin-bottom: 16rpx; padding-left: 8rpx; }
.recent-list { background: #fff; border-radius: 12rpx; overflow: hidden; }
.recent-item { display: flex; justify-content: space-between; align-items: center; padding: 24rpx; border-bottom: 1rpx solid #f0f0f0; }
.recent-item:last-child { border-bottom: none; }
.recent-item:active { background: #f5f5f5; }
.recent-code { font-size: 36rpx; font-weight: 700; color: #1aad19; letter-spacing: 4rpx; }
.recent-time { font-size: 24rpx; color: #7A7E83; }

.help-row { text-align: center; margin-top: 80rpx; }
.help-link { font-size: 24rpx; color: #999; text-decoration: underline; }
