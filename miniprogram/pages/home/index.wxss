.home { padding: 40rpx 40rpx 60rpx; min-height: 100vh; box-sizing: border-box; }
.hero { text-align: center; margin: 40rpx 0 60rpx; }
.title { display: block; font-size: 72rpx; font-weight: 700; color: #1aad19; letter-spacing: 8rpx; }

.profile { display: flex; flex-direction: column; align-items: center; gap: 16rpx; padding: 32rpx; background: #fff; border-radius: 16rpx; margin-bottom: 40rpx; }
.profile:active { background: #f5f5f5; }
.avatar { width: 120rpx; height: 120rpx; border-radius: 50%; background: #f0f0f0; }
.nick { font-size: 32rpx; font-weight: 600; color: #333; }

.actions { display: flex; flex-direction: column; gap: 24rpx; }
.btn { width: 100%; height: 88rpx; line-height: 88rpx; font-size: 32rpx; border-radius: 12rpx; margin: 0; }
.btn.primary { background: #1aad19; color: #fff; border: none; }
.btn.primary::after { border: none; }
.btn.default { background: #fff; color: #333; border: 1rpx solid #e0e0e0; }
.btn.default::after { border: none; }
.loading-tip { text-align: center; padding: 24rpx 0; color: #7A7E83; font-size: 26rpx; }

.my-rooms { margin-top: 60rpx; }
.section-title { font-size: 26rpx; color: #7A7E83; margin-bottom: 16rpx; padding-left: 8rpx; }
.room-list { background: #fff; border-radius: 12rpx; overflow: hidden; }
.room-item { display: flex; justify-content: space-between; align-items: center; padding: 24rpx; border-bottom: 1rpx solid #f0f0f0; }
.room-item:last-child { border-bottom: none; }
.room-item:active { background: #f5f5f5; }
.room-item .code { font-size: 36rpx; font-weight: 700; color: #1aad19; letter-spacing: 4rpx; }
.room-item .time { font-size: 30rpx; font-weight: 600; color: #333; }
.room-item .meta { font-size: 24rpx; color: #7A7E83; }
.room-item.finished .code { color: #7A7E83; }
.room-item.finished { align-items: center; }
.room-item-left { display: flex; flex-direction: column; gap: 4rpx; flex: 1; }
.view-btn { font-size: 26rpx; color: #1aad19; padding: 8rpx 16rpx; border: 1rpx solid #1aad19; border-radius: 6rpx; flex-shrink: 0; }
.view-btn:active { background: #1aad19; color: #fff; }

.help-row { text-align: center; margin-top: 80rpx; }
.help-link { font-size: 24rpx; color: #999; text-decoration: underline; }

/* 头像选择弹窗 */
.avatar-popup-overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 999; }
.avatar-popup { background: #fff; border-radius: 24rpx; padding: 40rpx 32rpx 32rpx; width: 88%; max-width: 640rpx; box-sizing: border-box; }
.popup-title { font-size: 36rpx; font-weight: 700; color: #333; text-align: center; margin-bottom: 32rpx; }
.avatar-grid { display: flex; flex-wrap: wrap; gap: 20rpx; justify-content: center; }
.avatar-item { display: flex; flex-direction: column; align-items: center; gap: 8rpx; width: 100rpx; }
.avatar-item:active { opacity: 0.7; }
.avatar-item.selected .avatar-img { border: 4rpx solid #1aad19; border-radius: 50%; }
.avatar-img { width: 88rpx; height: 88rpx; border-radius: 50%; background: #f5f5f5; }
.avatar-name { font-size: 22rpx; color: #333; text-align: center; }
.popup-actions { display: flex; align-items: center; justify-content: space-between; margin-top: 32rpx; padding-top: 24rpx; border-top: 1rpx solid #f0f0f0; }
.btn-text { font-size: 28rpx; color: #7A7E83; background: none; border: none; padding: 0; }
.btn-text::after { border: none; }
.btn-primary-small { background: #1aad19; color: #fff; font-size: 28rpx; padding: 16rpx 40rpx; border-radius: 12rpx; border: none; }
.btn-primary-small::after { border: none; }
