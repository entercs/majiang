.home {
  padding: 0 40rpx 60rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: #F7F5F0;
}

/* 品牌标题区 */
.hero {
  text-align: center;
  padding: 48rpx 0;
}
.title {
  display: block;
  font-size: 64rpx;
  font-weight: 700;
  color: #0F7A38;
  letter-spacing: 8rpx;
}
.title-underline {
  display: block;
  width: 80rpx;
  height: 4rpx;
  background: #C8A96E;
  margin: 16rpx auto 0;
}

/* 用户信息卡片 */
.profile {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 32rpx;
  background: #fff;
  border-radius: 32rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
  margin-bottom: 48rpx;
}
.profile:active {
  opacity: 0.8;
}
.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #f0f0f0;
}
.nick {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
}

/* 操作按钮组 */
.actions {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-bottom: 48rpx;
}
.btn {
  width: 100%;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 20rpx;
  margin: 0;
}
.btn.primary {
  background: linear-gradient(90deg, #0F7A38, #2BA85A);
  color: #fff;
  border: none;
  box-shadow: 0 4rpx 16rpx rgba(15, 122, 56, 0.2);
}
.btn.primary::after {
  border: none;
}
.btn.default {
  background: #fff;
  color: #0F7A38;
  border: 2rpx solid #0F7A38;
}
.btn.default::after {
  border: none;
}
.loading-tip {
  text-align: center;
  padding: 24rpx 0;
  color: #7A7E83;
  font-size: 26rpx;
}

/* 进行中/已结束列表 */
.my-rooms {
  margin-top: 48rpx;
}
.section-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #1A1A1A;
  margin-bottom: 16rpx;
  padding-left: 8rpx;
}
.room-list {
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}
.room-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx;
  border-bottom: 1rpx solid #EEEEEE;
}
.room-item:last-child {
  border-bottom: none;
}
.room-item:active {
  background: #f5f5f5;
}
.room-item .code {
  font-size: 40rpx;
  font-weight: 700;
  color: #0F7A38;
  letter-spacing: 4rpx;
}
.room-item .meta {
  font-size: 28rpx;
  color: #999999;
}
.room-item.finished {
  align-items: center;
}
.room-item.finished .code {
  color: #999999;
}
.room-item-left {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  flex: 1;
}
.room-item .time {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}
.view-btn {
  font-size: 26rpx;
  color: #0F7A38;
  padding: 8rpx 16rpx;
  border: 1rpx solid #0F7A38;
  border-radius: 16rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
.view-btn:active {
  background: #0F7A38;
  color: #fff;
}

/* 底部帮助 */
.help-row {
  text-align: center;
  margin-top: 80rpx;
}
.help-link {
  font-size: 26rpx;
  color: #999999;
}

/* 头像选择弹窗 */
.avatar-popup-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}
.avatar-popup {
  background: #fff;
  border-radius: 32rpx;
  padding: 40rpx 32rpx 32rpx;
  width: 88%;
  max-width: 640rpx;
  box-sizing: border-box;
}
.popup-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1A1A1A;
  text-align: center;
  margin-bottom: 32rpx;
}
.avatar-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  justify-content: center;
}
.avatar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  width: 100rpx;
}
.avatar-item:active {
  opacity: 0.7;
}
.avatar-item.selected .avatar-img {
  border: 4rpx solid #0F7A38;
  border-radius: 50%;
}
.avatar-img {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #f5f5f5;
}
.avatar-name {
  font-size: 22rpx;
  color: #666666;
  text-align: center;
}
.popup-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 32rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #EEEEEE;
}
.btn-text {
  font-size: 28rpx;
  color: #666666;
  background: none;
  border: none;
  padding: 0;
}
.btn-text::after {
  border: none;
}
.btn-primary-small {
  background: linear-gradient(90deg, #0F7A38, #2BA85A);
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
  padding: 16rpx 40rpx;
  border-radius: 16rpx;
  border: none;
}
.btn-primary-small::after {
  border: none;
}