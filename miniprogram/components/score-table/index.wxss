.score-table {
  background: #fff;
  border-radius: 24rpx;
  padding: 16rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}
.row {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 2rpx solid #EEEEEE;
}
.row:last-child {
  border-bottom: none;
}
.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
}
.nick {
  flex: 1;
  margin-left: 16rpx;
  font-size: 28rpx;
  color: #1A1A1A;
}
.score {
  font-size: 30rpx;
  font-weight: 600;
}
.score.positive {
  color: #0F7A38;
}
.score.negative {
  color: #D32F2F;
}