.popup-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.popup-panel {
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 32rpx 32rpx;
  width: 80%;
  max-width: 600rpx;
  box-sizing: border-box;
}

/* 当前头像大图 */
.avatar-display {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 24rpx;
}

.avatar-large {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
}

.nickname-display {
  margin-top: 12rpx;
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

/* 头像网格 */
.avatar-grid { width: 100%; }

.avatar-row {
  display: flex;
  justify-content: center;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.avatar-row:last-child { margin-bottom: 0; }

.avatar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.avatar-item:active { opacity: 0.65; }

.avatar-item.selected .avatar-img {
  border: 4rpx solid #1aad19;
  border-radius: 50%;
  padding: 2rpx;
  box-sizing: border-box;
}

.avatar-img {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
}

.avatar-name {
  font-size: 22rpx;
  color: #333;
}

/* 输入框 */
.nickname-input {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #333;
  margin-top: 24rpx;
}

/* 按钮 */
/* 昵称选择区 */
.nickname-section {
  width: 100%;
  margin-top: 24rpx;
}

.nickname-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.nickname-row:last-child {
  border-bottom: none;
}

.nickname-radio {
  width: 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  border: 2rpx solid #ccc;
  flex-shrink: 0;
  position: relative;
}

.nickname-radio.selected {
  border-color: #1aad19;
}

.nickname-radio.selected::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #1aad19;
}

.nickname-label {
  font-size: 26rpx;
  color: #666;
  width: 140rpx;
  flex-shrink: 0;
}

.nickname-value {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  background: #f5f5f5;
  border-radius: 8rpx;
  padding: 0 16rpx;
  height: 64rpx;
  line-height: 64rpx;
  box-sizing: border-box;
}

.nickname-value.editable {
  background: #fff;
  border: 2rpx solid #1aad19;
}

.nickname-value.readonly {
  color: #888;
}

/* 按钮 */
.popup-btns {
  display: flex;
  gap: 16rpx;
  width: 100%;
  margin-top: 24rpx;
}

.popup-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.popup-btn.cancel {
  background: #f5f5f5;
  color: #333;
}

.popup-btn.confirm {
  background: #1aad19;
  color: #fff;
}