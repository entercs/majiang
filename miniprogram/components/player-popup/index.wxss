.popup-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.popup-panel {
  background: #fff;
  border-radius: 32rpx;
  padding: 40rpx 32rpx 32rpx;
  width: 80%;
  max-width: 600rpx;
  box-sizing: border-box;
  box-shadow: 0 16rpx 64rpx rgba(0, 0, 0, 0.12);
}

/* 头像网格 */
.avatar-grid {
  width: 100%;
  margin-bottom: 32rpx;
}

.avatar-row {
  display: flex;
  justify-content: center;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.avatar-row:last-child {
  margin-bottom: 0;
}

.avatar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.avatar-item:active {
  opacity: 0.65;
}

.avatar-item.selected .avatar-img {
  border: 4rpx solid #0F7A38;
  border-radius: 50%;
  padding: 2rpx;
  box-sizing: border-box;
}

.avatar-img {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
}

.avatar-name {
  font-size: 26rpx;
  color: #666666;
}

/* 昵称选择区 */
.nickname-section {
  width: 100%;
  margin-top: 24rpx;
  border-top: 2rpx solid #EEEEEE;
  padding-top: 24rpx;
}

.nickname-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}

.nickname-radio {
  width: 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  border: 2rpx solid #CCCCCC;
  flex-shrink: 0;
  position: relative;
}

.nickname-radio.selected {
  border-color: #0F7A38;
}

.nickname-radio.selected::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #0F7A38;
}

.nickname-label {
  font-size: 26rpx;
  color: #666666;
  width: 140rpx;
  flex-shrink: 0;
}

.nickname-value {
  flex: 1;
  font-size: 28rpx;
  color: #1A1A1A;
  background: #F5F5F5;
  border-radius: 16rpx;
  padding: 0 24rpx;
  height: 72rpx;
  line-height: 72rpx;
  box-sizing: border-box;
}

.nickname-value.editable {
  background: #fff;
  border: 2rpx solid #0F7A38;
}

.nickname-value.readonly {
  color: #888888;
}

/* 按钮 */
.popup-btns {
  display: flex;
  gap: 16rpx;
  width: 100%;
  margin-top: 32rpx;
}

.popup-btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
}

.popup-btn.cancel {
  background: #F5F5F5;
  color: #666666;
}

.popup-btn.confirm {
  background: linear-gradient(90deg, #0F7A38, #2BA85A);
  color: #fff;
  box-shadow: 0 4rpx 16rpx rgba(15, 122, 56, 0.2);
}

.popup-btn::after {
  border: none;
}