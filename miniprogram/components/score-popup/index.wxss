.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}
.popup {
  width: 80%;
  max-width: 600rpx;
  background: #fff;
  border-radius: 32rpx;
  padding: 40rpx 32rpx;
  box-sizing: border-box;
  box-shadow: 0 16rpx 64rpx rgba(0, 0, 0, 0.12);
}
.title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1A1A1A;
  text-align: center;
  margin-bottom: 32rpx;
  line-height: 1.4;
}

.stepper-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 32rpx;
}
.stepper-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #E8F5ED;
  color: #0F7A38;
  border-radius: 50%;
  font-size: 40rpx;
  font-weight: 600;
}
.stepper-btn:active {
  opacity: 0.8;
}
.stepper-input {
  flex: 1;
  height: 80rpx;
  border: 2rpx solid #EEEEEE;
  border-radius: 16rpx;
  padding: 0 16rpx;
  font-size: 48rpx;
  font-weight: 600;
  text-align: center;
  box-sizing: border-box;
  background: #F7F5F0;
  color: #1A1A1A;
}
.stepper-input:focus {
  border-color: #0F7A38;
}

.quick-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 32rpx;
}
.quick-btn {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #E8F5ED;
  color: #0F7A38;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
}
.quick-btn:active {
  background: #d6ecc4;
}

.btn-row {
  display: flex;
  gap: 16rpx;
}
.btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  font-size: 32rpx;
  font-weight: 500;
}
.btn.cancel {
  background: #F5F5F5;
  color: #666666;
}
.btn.confirm {
  background: linear-gradient(90deg, #0F7A38, #2BA85A);
  color: #fff;
  box-shadow: 0 4rpx 16rpx rgba(15, 122, 56, 0.2);
}
.btn:active {
  opacity: 0.8;
}
button.btn.confirm {
  margin: 0;
  padding: 0;
  line-height: normal;
}
button.btn.confirm::after {
  border: none;
}
button.btn.confirm[disabled] {
  background: #E5E5E5;
  color: #999999;
  box-shadow: none;
}
button.btn.confirm[disabled]:active {
  opacity: 1;
}
