.mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}
.popup {
  width: 80%;
  max-width: 600rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx 32rpx;
  box-sizing: border-box;
}
.title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
  text-align: center;
  margin-bottom: 32rpx;
}

.stepper-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.stepper-btn {
  width: 80rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background: #f5f5f5;
  color: #333;
  border-radius: 12rpx;
  font-size: 40rpx;
  font-weight: 600;
}
.stepper-btn:active { background: #e0e0e0; }
.stepper-input {
  flex: 1;
  height: 80rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 0 16rpx;
  font-size: 36rpx;
  font-weight: 600;
  text-align: center;
  box-sizing: border-box;
}

.quick-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 32rpx;
}
.quick-btn {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  background: #f0f8e8;
  color: #1aad19;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
}
.quick-btn:active { background: #d6ecc4; }

.btn-row {
  display: flex;
  gap: 16rpx;
}
.btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
}
.btn.cancel { background: #f5f5f5; color: #333; }
.btn.confirm { background: #1aad19; color: #fff; }
.btn:active { opacity: 0.8; }