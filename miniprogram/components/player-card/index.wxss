.player-card {
  display: flex;
  align-items: center;
  padding: 16rpx;
  border: 2rpx solid #EEEEEE;
  border-radius: 24rpx;
  background: #fff;
}
.player-card.selected {
  border-color: #0F7A38;
  background: #E8F5ED;
}
.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
}
.info {
  flex: 1;
  margin-left: 16rpx;
  display: flex;
  flex-direction: column;
}
.nick {
  font-size: 28rpx;
  color: #1A1A1A;
}
.seat {
  font-size: 22rpx;
  color: #999999;
}
.score {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
}